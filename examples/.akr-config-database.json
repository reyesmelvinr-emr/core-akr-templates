{
  "$schema": "./.akr/schemas/akr-config-schema.json",
  "version": "2.0.0",
  
  "projectInfo": {
    "name": "database",
    "description": "SQL Server database schema and procedures",
    "layer": "Database",
    "domains": ["DataStorage", "DataIntegrity"],
    "team": {
      "name": "Team Hawkeye",
      "lead": "Bob Johnson",
      "contact": "team-hawkeye@company.com"
    },
    "repositoryUrl": "https://github.com/your-org/database.git"
  },
  
  "documentation": {
    "outputPath": "docs/",
    "componentMappings": {
      "tables/": "docs/tables/",
      "procedures/": "docs/procedures/",
      "views/": "docs/views/",
      "functions/": "docs/functions/"
    },
    "templatePreferences": {
      "table": "table-comprehensive",
      "procedure": "procedure-technical"
    },
    "includePatterns": [
      "tables/**/*.sql",
      "procedures/**/*.sql",
      "views/**/*.sql",
      "functions/**/*.sql"
    ],
    "excludePatterns": [
      "**/archive/**",
      "**/deprecated/**"
    ],
    "autoGenerateOnSave": false,
    "requireReviewBeforeCommit": true
  },
  
  "crossRepository": {
    "enabled": true,
    "consolidationRepo": "https://github.com/your-org/documentation-hub.git",
    "registryUrl": "https://raw.githubusercontent.com/your-org/core-templates/main/.akr/tags/tag-registry.json",
    "publishFeatureDocs": true,
    "relatedRepositories": [
      {
        "name": "web-ui",
        "url": "https://github.com/your-org/web-ui.git",
        "layer": "UI",
        "docsPath": "docs/"
      },
      {
        "name": "api-services",
        "url": "https://github.com/your-org/api-services.git",
        "layer": "API",
        "docsPath": "docs/"
      }
    ],
    "syncSchedule": {
      "enabled": true,
      "frequency": "daily"
    }
  },
  
  "tags": {
    "requireApproved": true,
    "registryPath": ".akr/tags/tag-registry.json",
    "autoNormalize": true,
    "warnOnUnapproved": true
  },
  
  "validation": {
    "enabled": true,
    "vale": {
      "enabled": true,
      "configPath": ".vale.ini",
      "minAlertLevel": "warning"
    },
    "tagValidation": {
      "enabled": true,
      "requiredTags": ["feature", "domain", "layer"],
      "minCompletenessScore": 0.7
    },
    "onValidationFailure": "warn"
  },
  
  "github": {
    "enableActions": true,
    "prComments": {
      "enabled": true,
      "showValeResults": true,
      "showTagValidation": true
    },
    "checks": {
      "enabled": true,
      "requirePassing": false
    },
    "wiki": {
      "autoPublish": false,
      "syncOnMerge": false
    }
  },
  
  "humanInput": {
    "enabled": true,
    "triggerMode": "on-new-file",
    "priorityFilter": "important",
    "defaultRole": "developer",
    "allowSkip": true,
    "saveProgress": true
  },
  
  "monitoring": {
    "enabled": false,
    "trackMetrics": ["generation-time", "validation-results"]
  }
}
