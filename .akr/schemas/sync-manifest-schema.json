{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://akr-templates.com/schemas/sync-manifest-schema.json",
  "title": "AKR Source Evidence Sync Manifest",
  "description": "Schema for sync-manifest.json generated by sync-source-evidence workflow.",
  "type": "object",
  "required": [
    "source_repo",
    "branch",
    "commit_sha",
    "synced_at",
    "triggering_pr",
    "files_synced"
  ],
  "additionalProperties": false,
  "properties": {
    "source_repo": {
      "type": "string",
      "minLength": 1,
      "description": "Source repository in owner/repo format."
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "minLength": 1
    },
    "synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "triggering_pr": {
      "type": "string",
      "minLength": 1
    },
    "files_synced": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
