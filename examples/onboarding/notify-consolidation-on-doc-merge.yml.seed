name: Notify Consolidation on Doc Merge

# AKR POC: This workflow is seeded into source (application) repositories by distribute-onboarding-bundle.yml.
# It fires a repository_dispatch event to the business consolidation repository whenever
# documentation files are merged to the default branch.
#
# Required setup before this workflow is active:
#   1. Set the AKR_CONSOLIDATION_REPO Actions variable in this repository's Settings > Variables > Actions.
#      Value must be in owner/repo format (e.g. reyesmelvinr-emr/training_tracker_business).
#   2. Ensure AKR_DISTRIBUTION_PAT secret is configured with write access to the consolidation repo.
#
# POC note: This is included automatically during onboarding for proof-of-concept convenience.
# Teams may opt out by disabling or removing this workflow. The sync-source-evidence.yml workflow
# in the consolidation repo also supports manual dispatch as a fallback.

on:
  push:
    branches:
      - master
      - main
    paths:
      - "docs/services/**"
      - "docs/modules/**"
      - "modules.yaml"

permissions:
  contents: read

jobs:
  notify:
    name: Dispatch source-docs-updated to consolidation repo
    runs-on: ubuntu-latest
    env:
      GH_TOKEN: ${{ secrets.AKR_DISTRIBUTION_PAT }}
    steps:
      - name: Validate required configuration
        run: |
          if [ -z "${{ vars.AKR_CONSOLIDATION_REPO }}" ]; then
            echo "::warning::AKR_CONSOLIDATION_REPO Actions variable is not set. Sync notification skipped."
            echo "::warning::Set AKR_CONSOLIDATION_REPO to owner/repo of your business consolidation repository."
            exit 0
          fi
          if [ -z "${GH_TOKEN}" ]; then
            echo "::error::AKR_DISTRIBUTION_PAT secret is not configured. Required for cross-repo dispatch."
            exit 1
          fi

      - name: Resolve triggering PR URL
        id: pr
        if: vars.AKR_CONSOLIDATION_REPO != ''
        run: |
          triggering_pr=$(gh api \
            "repos/${{ github.repository }}/commits/${{ github.sha }}/pulls" \
            --jq '.[0].html_url // "no-pr-associated"' 2>/dev/null || echo "no-pr-associated")
          echo "url=$triggering_pr" >> "$GITHUB_OUTPUT"

      - name: Dispatch source-docs-updated event
        if: vars.AKR_CONSOLIDATION_REPO != ''
        run: |
          gh api \
            --method POST \
            -H "Accept: application/vnd.github+json" \
            "/repos/${{ vars.AKR_CONSOLIDATION_REPO }}/dispatches" \
            -f event_type="source-docs-updated" \
            -f "client_payload[source_repo]=${{ github.repository }}" \
            -f "client_payload[source_branch]=${{ github.ref_name }}" \
            -f "client_payload[commit_sha]=${{ github.sha }}" \
            -f "client_payload[triggering_pr]=${{ steps.pr.outputs.url }}"
          echo "Dispatched source-docs-updated to ${{ vars.AKR_CONSOLIDATION_REPO }}"
