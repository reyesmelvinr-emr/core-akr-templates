{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://akr-templates.com/schemas/modules-schema.json",
  "title": "AKR Modules Manifest Schema",
  "description": "Schema for modules.yaml used by AKR Mode A and Mode B workflows",
  "type": "object",
  "required": ["project", "modules", "database_objects", "unassigned"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "layer",
        "standards_version",
        "minimum_standards_version",
        "compliance_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "enum": ["UI", "API", "Database", "Integration", "Infrastructure", "Full-Stack"]
        },
        "standards_version": {
          "type": "string",
          "pattern": "^v?\\d+\\.\\d+\\.\\d+$"
        },
        "minimum_standards_version": {
          "type": "string",
          "pattern": "^v?\\d+\\.\\d+\\.\\d+$"
        },
        "compliance_mode": {
          "type": "string",
          "enum": ["pilot", "production"]
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "businessCapability",
          "feature",
          "project_type",
          "status",
          "max_files",
          "files",
          "doc_output"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "businessCapability": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "feature": {
            "type": "string",
            "pattern": "^FN\\d{5}_US\\d{3,}$"
          },
          "project_type": {
            "type": "string",
            "enum": ["api-backend", "ui-component", "microservice", "general"]
          },
          "status": {
            "type": "string",
            "enum": ["draft", "approved", "in-progress", "deprecated"]
          },
          "max_files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "doc_output": {
            "type": "string",
            "pattern": "^docs/.+\\.md$"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "database_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "source", "doc_output"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["table", "view", "procedure", "function", "schema"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "doc_output": {
            "type": "string",
            "pattern": "^docs/.+\\.md$"
          },
          "feature": {
            "type": "string",
            "pattern": "^FN\\d{5}_US\\d{3,}$"
          },
          "businessCapability": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          }
        }
      }
    },
    "unassigned": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
