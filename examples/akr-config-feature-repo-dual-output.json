{
  "version": "2.0.0",
  "projectInfo": {
    "name": "WebApp1_FeatureRepo",
    "description": "Application-level feature documentation and consolidated documentation hub",
    "layer": "Full-Stack",
    "domains": ["Authentication", "User Management", "Reporting"],
    "team": {
      "name": "Team Hawkeye",
      "lead": "Jane Doe",
      "contact": "jane.doe@example.com"
    },
    "repositoryUrl": "https://github.com/org/WebApp1_FeatureRepo"
  },
  
  "documentation": {
    "outputPath": "docs/",
    "componentMappings": {
      "features/": "docs/features/",
      "testing/": "docs/testing/"
    },
    "autoGenerateOnSave": false,
    "requireReviewBeforeCommit": true
  },
  
  "crossRepository": {
    "enabled": true,
    "consolidationRepo": "https://github.com/org/WebApp1_FeatureRepo.git",
    "registryUrl": "https://github.com/org/core-templates/.akr/tags/tag-registry.json",
    "publishFeatureDocs": true,
    "relatedRepositories": [
      {
        "name": "WebApp1_UI",
        "url": "https://github.com/org/WebApp1_UI.git",
        "layer": "UI",
        "docsPath": "docs/components/"
      },
      {
        "name": "WebApp1_API",
        "url": "https://github.com/org/WebApp1_API.git",
        "layer": "API",
        "docsPath": "docs/api/"
      },
      {
        "name": "WebApp1_Database",
        "url": "https://github.com/org/WebApp1_Database.git",
        "layer": "Database",
        "docsPath": "docs/database/"
      }
    ],
    "syncSchedule": {
      "enabled": true,
      "frequency": "on-push"
    },
    "outputs": [
      {
        "type": "feature",
        "template": "feature-consolidated.md",
        "outputPath": "docs/features/",
        "enabled": true,
        "linkStrategy": "bidirectional",
        "sectionMapping": {
          "includeFromComponentDocs": [
            "Overview",
            "Purpose",
            "Architecture",
            "Dependencies",
            "API Reference",
            "Data Model"
          ],
          "excludeFromComponentDocs": [
            "Testing",
            "Test Cases",
            "Test Coverage",
            "Test Strategy"
          ]
        },
        "metadata": {
          "owner": "Product Owner",
          "reviewRequired": true,
          "updateCadence": "monthly"
        }
      },
      {
        "type": "testing",
        "template": "feature-testing-consolidated.md",
        "outputPath": "docs/testing/",
        "enabled": true,
        "linkStrategy": "bidirectional",
        "sectionMapping": {
          "includeFromComponentDocs": [
            "Testing",
            "Test Cases",
            "Test Coverage",
            "Test Strategy",
            "Happy Path Tests",
            "Edge Cases",
            "Performance Tests"
          ],
          "excludeFromComponentDocs": [
            "Overview",
            "Architecture",
            "API Reference"
          ]
        },
        "metadata": {
          "owner": "QA Team",
          "reviewRequired": true,
          "updateCadence": "weekly"
        }
      }
    ]
  },
  
  "tags": {
    "requireApproved": true,
    "registryPath": "~/.akr/tags/tag-registry.json",
    "autoNormalize": true,
    "warnOnUnapproved": true
  },
  
  "validation": {
    "enabled": true,
    "vale": {
      "enabled": true,
      "configPath": ".vale.ini",
      "minAlertLevel": "warning"
    },
    "tagValidation": {
      "enabled": true,
      "requiredTags": ["feature", "domain", "layer"],
      "minCompletenessScore": 0.8
    },
    "onValidationFailure": "warn"
  },
  
  "github": {
    "enableActions": true,
    "prComments": {
      "enabled": true,
      "showValeResults": true,
      "showTagValidation": true
    },
    "checks": {
      "enabled": true,
      "requirePassing": true
    }
  },
  
  "humanInput": {
    "enabled": true,
    "triggerMode": "on-new-file",
    "priorityFilter": "important",
    "defaultRole": "developer",
    "allowSkip": true,
    "saveProgress": true
  },
  
  "monitoring": {
    "enabled": true,
    "trackMetrics": [
      "generation-time",
      "validation-results",
      "cross-repo-sync"
    ]
  }
}
