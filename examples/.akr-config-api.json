{
  "$schema": "./.akr/schemas/akr-config-schema.json",
  "version": "2.0.0",
  
  "projectInfo": {
    "name": "api-services",
    "description": ".NET Core Web API services",
    "layer": "API",
    "domains": ["ApplicationManagement", "UserManagement", "DataProcessing"],
    "team": {
      "name": "Team Hawkeye",
      "lead": "Jane Smith",
      "contact": "team-hawkeye@company.com"
    },
    "repositoryUrl": "https://github.com/your-org/api-services.git"
  },
  
  "documentation": {
    "outputPath": "docs/",
    "componentMappings": {
      "src/Controllers/": "docs/controllers/",
      "src/Services/": "docs/services/",
      "src/Models/": "docs/models/",
      "src/Middleware/": "docs/middleware/"
    },
    "templatePreferences": {
      "controller": "controller-technical",
      "service": "service-technical",
      "utility": "utility-comprehensive"
    },
    "includePatterns": [
      "src/**/*.cs"
    ],
    "excludePatterns": [
      "**/bin/**",
      "**/obj/**",
      "**/*.Test.*",
      "**/Tests/**"
    ],
    "autoGenerateOnSave": false,
    "requireReviewBeforeCommit": true
  },
  
  "crossRepository": {
    "enabled": true,
    "consolidationRepo": "https://github.com/your-org/documentation-hub.git",
    "registryUrl": "https://raw.githubusercontent.com/your-org/core-templates/main/.akr/tags/tag-registry.json",
    "publishFeatureDocs": true,
    "relatedRepositories": [
      {
        "name": "web-ui",
        "url": "https://github.com/your-org/web-ui.git",
        "layer": "UI",
        "docsPath": "docs/"
      },
      {
        "name": "database",
        "url": "https://github.com/your-org/database.git",
        "layer": "Database",
        "docsPath": "docs/"
      }
    ],
    "syncSchedule": {
      "enabled": true,
      "frequency": "on-push"
    }
  },
  
  "tags": {
    "requireApproved": true,
    "registryPath": ".akr/tags/tag-registry.json",
    "autoNormalize": true,
    "warnOnUnapproved": true
  },
  
  "validation": {
    "enabled": true,
    "vale": {
      "enabled": true,
      "configPath": ".vale.ini",
      "minAlertLevel": "warning"
    },
    "tagValidation": {
      "enabled": true,
      "requiredTags": ["feature", "domain", "layer"],
      "minCompletenessScore": 0.7
    },
    "onValidationFailure": "warn"
  },
  
  "github": {
    "enableActions": true,
    "prComments": {
      "enabled": true,
      "showValeResults": true,
      "showTagValidation": true
    },
    "checks": {
      "enabled": true,
      "requirePassing": false
    },
    "wiki": {
      "autoPublish": false,
      "syncOnMerge": false
    }
  },
  
  "humanInput": {
    "enabled": true,
    "triggerMode": "on-new-file",
    "priorityFilter": "important",
    "defaultRole": "developer",
    "allowSkip": true,
    "saveProgress": true
  },
  
  "monitoring": {
    "enabled": false,
    "trackMetrics": ["generation-time", "validation-results"]
  },

  "scoring": {
    "minimum_combined_score": 70,
    "minimum_semantic_score": 60,
    "minimum_structural_score": 80,
    "block_on_template_text": false,
    "block_on_unengaged_sections": false,
    "advisory_only": true
  }
}
